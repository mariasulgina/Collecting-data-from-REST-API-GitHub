{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=github_lab.db"
  },
  "ScrapingSettings": {
    "UserAgent": "InternetTechLab1-Scraper/1.0",
    "TimeoutSeconds": 10,
    "MaxBodyLength": 500
  },
  "GitHubSettings": {
    "UserAgent": "InternetTechLab1-App",
    "AcceptHeader": "application/vnd.github.v3+json",
    "TimeoutSeconds": 10,
    "BaseUrl": "https://api.github.com/"
  },
  "NoSqlSettings": {
    "Uri": "mongodb://localhost:27017",
    "DatabaseName": "scraped_data"
  },
  "LoggingSettings": {
    "LogFilePath": "log.txt"
  }
}
